---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, localeMeta, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { sameAlternates, type Alternates } from '../i18n/routes';

interface Props {
  locale: Locale;
  /** Where each language's version of the current page lives. */
  alternates?: Alternates;
}

const { locale, alternates = sameAlternates('') } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label={t('a11y.languageSwitcher')}>
  <ul class="flex gap-4">
    {locales.map((l) => (
      <li>
        <a
          href={getRelativeLocaleUrl(l, alternates[l])}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
          class="aria-[current]:underline"
        >
          {localeMeta[l].label}
        </a>
      </li>
    ))}
  </ul>
</nav>
