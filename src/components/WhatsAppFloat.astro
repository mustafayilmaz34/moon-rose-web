---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { whatsappUrl } from '../config/site';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
// The accessible name must contain the visible bubble text (WCAG 2.5.3 Label in Name).
---

<a
  href={whatsappUrl}
  aria-label={`${t('whatsapp.bubble')} — WhatsApp`}
  class="group fixed end-5 bottom-5 z-30 flex items-center gap-3"
>
  <span
    class="motion-wa-bubble bg-surface text-ink hidden rounded-full px-4 py-2.5 text-sm font-semibold shadow-[0_10px_30px_-12px_rgb(15_42_74/0.45)] lg:block"
    aria-hidden="true"
  >
    {t('whatsapp.bubble')}
  </span>
  <span class="relative grid size-14 place-items-center">
    <!-- Pulse ring: three soft pulses after load, then it rests (no endless motion). -->
    <span
      class="motion-wa-ring bg-whatsapp absolute inset-0 rounded-full opacity-0"
      aria-hidden="true"
    ></span>
    <span class="bg-whatsapp text-surface relative grid size-14 place-items-center rounded-full shadow-[0_10px_28px_-8px_rgb(18_140_126/0.6)] transition-transform duration-300 group-hover:scale-[1.07] group-active:scale-95">
      <Icon name="whatsapp" class="size-7" />
    </span>
  </span>
</a>
