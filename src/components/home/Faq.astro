---
// Native <details>: works without JS, keyboard and screen-reader friendly.
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { sectionIds } from '../../lib/nav';
import { faq } from '../../data/faq';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items = faq[locale];
---

<section id={sectionIds.faq} class="mx-auto max-w-[1320px] px-6 py-20 lg:px-12 lg:py-28">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">{t('nav.faq')}</p>
      <h2 class="font-display mt-5 text-4xl leading-[1.1] font-[380] italic lg:text-5xl rtl:leading-[1.4]">
        {t('faq.title')}
      </h2>
    </div>
    <div class="border-line border-t lg:col-span-8">
      {items.map((item) => (
        <details class="group border-line border-b">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="border-line group-open:bg-ink group-open:text-surface mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border transition-colors">
              <Icon
                name="close"
                class="size-3.5 rotate-45 transition-transform duration-300 group-open:rotate-0"
              />
            </span>
          </summary>
          <div class="text-muted max-w-[65ch] pb-7 leading-relaxed">
            {item.a.split('\n\n').map((para) => (
              <p class="mt-3 first:mt-0">{para}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
