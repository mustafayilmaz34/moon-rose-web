---
// Full-bleed video hero. The header floats over it (SiteLayout overlayHeader).
// Video: client's existing asset, generated with Google Veo — the watermark stays visible; never crop it out.
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { site, whatsappUrl } from '../../config/site';
import heroPoster from '../../assets/legacy/hero-poster.jpg';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const poster = await getImage({ src: heroPoster, width: 1600, format: 'webp' });
---

<section
  data-hero
  class="text-surface relative isolate -mt-20 flex min-h-[100svh] flex-col overflow-hidden lg:min-h-[min(100svh,920px)]"
>
  <video
    data-hero-video
    class="motion-hero-media absolute inset-0 -z-20 h-full w-full object-cover"
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster.src}
    aria-hidden="true"
  >
    <source src="/media/hero-loop.mp4" type="video/mp4" />
  </video>
  <!-- Legibility scrim: darker top (nav), soft vignette behind the text, darker bottom (info row). -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="from-ink/55 to-ink/0 absolute inset-x-0 top-0 h-40 bg-gradient-to-b"></div>
    <div class="bg-ink/15 absolute inset-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_52%,rgb(15_42_74/0.45),transparent_75%)]"></div>
    <div class="from-ink/75 to-ink/0 absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t"></div>
  </div>

  <div class="motion-hero-content flex flex-1 items-center justify-center px-6 pt-28 pb-16">
    <div class="mx-auto max-w-[56rem] text-center">
      <p class="motion-rise text-xs font-semibold tracking-[0.18em] uppercase opacity-85 sm:tracking-[0.28em]">
        {t('hero.eyebrow')}
      </p>
      <h1
        style="--d: 120ms"
        class="motion-rise font-display mt-7 text-[clamp(2.9rem,7.4vw,6.4rem)] leading-[1.02] font-[370] tracking-[-0.01em] italic [text-shadow:0_2px_30px_rgb(15_42_74/0.35)] rtl:leading-[1.3]"
      >
        {t('hero.title')}
      </h1>
      <p class="motion-rise mx-auto mt-7 max-w-[44ch] text-lg leading-relaxed opacity-90" style="--d: 240ms">
        {t('hero.lead')}
      </p>
      <div
        class="motion-rise mt-11 flex flex-wrap items-center justify-center gap-x-10 gap-y-6"
        style="--d: 360ms"
      >
        <a
          href={whatsappUrl}
          class="bg-surface text-ink hover:bg-panel label-caps rounded-full px-9 py-4.5 transition-colors"
        >
          {t('cta.appointment')}
        </a>
        <a href={site.phoneHref} class="group flex items-center gap-3" dir="ltr">
          <span class="border-surface/40 group-hover:border-surface grid size-12 place-items-center rounded-full border transition-colors">
            <Icon name="phone" class="size-5" />
          </span>
          <span class="text-[1.75rem] font-light tracking-[-0.01em]">{site.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom info row (md+; on phones the info bar and footer carry this) -->
  <div class="motion-rise border-surface/20 hidden border-t md:block" style="--d: 600ms">
    <div class="mx-auto flex max-w-[1320px] items-center gap-6 px-6 py-5 lg:px-12">
      <dl class="grid flex-1 grid-cols-3 gap-8 text-sm">
        <div>
          <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
            {t('info.addressLabel')}
          </dt>
          <dd class="mt-1">{t('info.address')}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
            {t('info.hoursLabel')}
          </dt>
          <dd class="mt-1">
            {t('info.hours')} · <span class="opacity-75">{t('info.hoursNote')}</span>
          </dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
            {t('info.contactLabel')}
          </dt>
          <dd class="mt-1">
            <a href={whatsappUrl} class="underline decoration-1 underline-offset-4 hover:opacity-80">
              {t('info.contact')}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  // Autoplay only when motion is allowed; otherwise the poster frame stays.
  // No pause control by client decision (2026-11-08) — see DESIGN.md → Hareket.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.play().catch(() => {
      /* Autoplay blocked or codec unsupported: the poster stays. */
    });
  }
</script>
