---
import TreatmentCard from '../TreatmentCard.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { routeUrl } from '../../i18n/routes';
import { sectionIds } from '../../lib/nav';
import { treatmentsFor } from '../../lib/treatments';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entries = (await treatmentsFor(locale)).slice(0, 6);
---

<section id={sectionIds.treatments} class="bg-panel">
  <div class="mx-auto max-w-[1320px] px-6 py-20 lg:px-12 lg:py-28">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h2 class="font-display text-4xl font-[380] italic lg:text-6xl">{t('nav.treatments')}</h2>
        <p class="text-muted mt-5 max-w-[40ch] leading-relaxed">{t('treatments.intro')}</p>
      </div>
      <a
        href={routeUrl(locale, 'treatments')}
        class="group inline-flex items-center gap-2 text-sm font-semibold"
      >
        {t('treatments.all')}
        <Icon
          name="arrow"
          class="size-4 transition-transform group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1"
        />
      </a>
    </div>
    <ul class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <li class="motion-reveal">
          <TreatmentCard locale={locale} entry={entry} />
        </li>
      ))}
    </ul>
  </div>
</section>
