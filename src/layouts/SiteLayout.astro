---
// Page chrome shared by every public page: info bar + header, footer, floating WhatsApp.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import type { Locale } from '../i18n/config';
import { sameAlternates, type Alternates } from '../i18n/routes';

interface Props {
  locale: Locale;
  /** This page's path in every language. Default: the home page. */
  alternates?: Alternates;
  title?: string;
  description?: string;
  /** Page starts with a full-bleed hero the header should float over. */
  overlayHeader?: boolean;
  noindex?: boolean;
}

const {
  locale,
  alternates = sameAlternates(''),
  title,
  description,
  overlayHeader = false,
  noindex = false,
} = Astro.props;
---

<BaseLayout locale={locale} alternates={alternates} title={title} description={description} noindex={noindex}>
  <SiteHeader slot="header" locale={locale} alternates={alternates} overlay={overlayHeader} />
  <slot />
  <Fragment slot="footer">
    <SiteFooter locale={locale} />
    <WhatsAppFloat locale={locale} />
  </Fragment>
</BaseLayout>
