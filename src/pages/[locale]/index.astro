---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Hero from '../../components/home/Hero.astro';
import About from '../../components/home/About.astro';
import Treatments from '../../components/home/Treatments.astro';
import AppointmentBand from '../../components/home/AppointmentBand.astro';
import { locales, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<SiteLayout locale={locale} overlayHeader>
  <Hero locale={locale} />
  <About locale={locale} />
  <Treatments locale={locale} />
  <AppointmentBand locale={locale} />
</SiteLayout>
