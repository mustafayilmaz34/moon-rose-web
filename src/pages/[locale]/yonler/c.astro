---
// Phase 1 — Direction C "Klinik mavisi": close to the current site, cleaned up. Temporary review page.
// Images are TEMPORARY copies from the current WordPress site (stock imagery) — licence to be confirmed.
import '../../../styles/directions.css';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import DirectionBar from '../../../components/DirectionBar.astro';
import { locales, type Locale } from '../../../i18n/config';
import { useTranslations, treatmentKeys } from '../../../i18n/ui';
import { site, whatsappUrl } from '../../../config/site';

import heroPoster from '../../../assets/legacy/hero-poster.jpg';
import aboutImg from '../../../assets/legacy/mins-pciture-scaled.jpg';
import botoxImg from '../../../assets/legacy/2-botoks.jpeg';
import fillerImg from '../../../assets/legacy/1-dolgu.jpeg';
import mesoImg from '../../../assets/legacy/doktor-salih-gul-min.jpg';
import pigmentImg from '../../../assets/legacy/3-yuz-germe.jpeg';
import threadImg from '../../../assets/legacy/11-ip-aski.jpeg';
import exosomeImg from '../../../assets/legacy/12-eksozom.jpeg';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const path = 'yonler/c/';
const nav = ['nav.about', 'nav.treatments', 'nav.faq', 'nav.contact'] as const;
const poster = await getImage({ src: heroPoster, width: 1600, format: 'webp' });
const treatmentImages = {
  botox: botoxImg,
  filler: fillerImg,
  meso: mesoImg,
  pigment: pigmentImg,
  thread: threadImg,
  exosome: exosomeImg,
};
---

<BaseLayout locale={locale} path={path} title="Yön C">
  <!-- Everything lives in one tall wrapper so the sticky header can stick for the whole page. -->
  <div class="theme-c bg-surface text-ink font-body">
    <DirectionBar locale={locale} current="c" />

    <!-- Info bar -->
    <div class="bg-ink text-surface text-[13px]">
      <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-6 px-6 py-2.5 lg:px-12">
        <div class="flex items-center gap-8">
          <p class="hidden items-center gap-2 opacity-85 md:flex">
            <svg
              viewBox="0 0 24 24"
              class="size-4 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path>
              <circle cx="12" cy="9.5" r="2.5"></circle>
            </svg>
            {t('info.address')}
          </p>
          <p class="hidden items-center gap-2 opacity-85 lg:flex">
            <svg
              viewBox="0 0 24 24"
              class="size-4 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            {t('info.hours')} · {t('info.hoursNote')}
          </p>
        </div>
        <div class="flex items-center gap-5">
          <a href={site.phoneHref} class="flex items-center gap-2 font-semibold hover:opacity-80" dir="ltr">
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
            </svg>
            {site.phoneDisplay}
          </a>
          <!-- TODO(client): Instagram handle — docs/CONTENT.md, question 3 -->
          <a href="#" aria-label="Instagram" class="hover:opacity-80">
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!--
      Header: transparent over the hero video, turns solid once the hero scrolls away.
      Without JS a <noscript> style keeps it solid so it stays readable over the white sections.
    -->
    <header
      data-site-header
      class="group/hdr text-surface data-solid:bg-surface data-solid:text-ink data-solid:border-line border-surface/20 sticky top-0 z-40 h-20 border-b transition-colors duration-300 data-solid:shadow-[0_6px_24px_-18px_rgb(15_42_74/0.5)]"
    >
      <div class="mx-auto flex h-full max-w-[1320px] items-center justify-between gap-6 px-6 lg:px-12">
        <a href="#" class="flex items-baseline gap-2.5" lang="en" dir="ltr">
          <span class="font-display text-[1.9rem] leading-none font-[420] italic">Moonrose</span>
          <span class="group-data-solid/hdr:text-accent text-[10px] font-semibold tracking-[0.3em] uppercase opacity-80 group-data-solid/hdr:opacity-100">
            Clinic
          </span>
        </a>
        <nav aria-label={t('a11y.mainNav')} class="hidden lg:block">
          <ul class="flex gap-9 text-[15px] font-semibold">
            {nav.map((key) => (
              <li>
                <a
                  href="#"
                  class="opacity-90 transition-opacity hover:opacity-100 group-data-solid/hdr:hover:text-accent"
                >
                  {t(key)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-6 text-sm">
          <div class="hidden sm:block">
            <LanguageSwitcher locale={locale} path={path} />
          </div>
          <a
            href={whatsappUrl}
            class="bg-surface text-ink group-data-solid/hdr:bg-ink group-data-solid/hdr:text-surface hover:bg-panel group-data-solid/hdr:hover:bg-accent rounded-full px-6 py-3 font-semibold transition-colors"
          >
            {t('cta.appointment')}
          </a>
        </div>
      </div>
    </header>
    <noscript>
      <style>
        [data-site-header] {
          background: var(--color-surface);
          color: var(--color-ink);
        }
      </style>
    </noscript>

    <!-- Hero: client's existing background video (Google Veo, watermark left visible — do not crop it out) -->
    <section
      data-hero
      class="text-surface relative isolate -mt-20 flex min-h-[100svh] flex-col overflow-hidden lg:min-h-[min(100svh,920px)]"
    >
      <video
        data-hero-video
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster.src}
        aria-hidden="true"
      >
        <source src="/media/hero-loop.mp4" type="video/mp4" />
      </video>
      <!-- Legibility scrim: soft vignette behind the centred text + darker top (nav) and bottom (info row). -->
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="from-ink/55 to-ink/0 absolute inset-x-0 top-0 h-40 bg-gradient-to-b"></div>
        <div class="bg-ink/15 absolute inset-0"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_52%,rgb(15_42_74/0.45),transparent_75%)]"></div>
        <div class="from-ink/75 to-ink/0 absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t"></div>
      </div>

      <div class="flex flex-1 items-center justify-center px-6 pt-28 pb-16">
        <div class="mx-auto max-w-[56rem] text-center">
          <p class="c-rise text-xs font-semibold tracking-[0.28em] uppercase opacity-85">
            {t('hero.eyebrow')}
          </p>
          <h1
            style="--d: 120ms"
            class="c-rise font-display mt-7 text-[clamp(2.9rem,7.4vw,6.4rem)] leading-[1.02] font-[370] tracking-[-0.01em] italic [text-shadow:0_2px_30px_rgb(15_42_74/0.35)] rtl:leading-[1.3]"
          >
            {t('hero.title')}
          </h1>
          <p class="c-rise mx-auto mt-7 max-w-[44ch] text-lg leading-relaxed opacity-90" style="--d: 240ms">
            {t('hero.lead')}
          </p>
          <div
            class="c-rise mt-11 flex flex-wrap items-center justify-center gap-x-10 gap-y-6"
            style="--d: 360ms"
          >
            <a
              href={whatsappUrl}
              class="bg-surface text-ink hover:bg-panel rounded-full px-9 py-4 text-sm font-bold tracking-wide transition-colors"
            >
              {t('cta.appointment')}
            </a>
            <a href={site.phoneHref} class="group flex items-center gap-3" dir="ltr">
              <span
                class="border-surface/40 group-hover:border-surface grid size-12 place-items-center rounded-full border transition-colors"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
                </svg>
              </span>
              <span class="text-2xl font-light tracking-wide">{site.phoneDisplay}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom info row -->
      <div class="c-rise border-surface/20 border-t" style="--d: 600ms">
        <div class="mx-auto flex max-w-[1320px] items-center gap-6 px-6 py-5 lg:px-12">
          <button
            type="button"
            data-hero-toggle
            data-label-pause={t('a11y.pauseVideo')}
            data-label-play={t('a11y.playVideo')}
            aria-label={t('a11y.pauseVideo')}
            hidden
            class="border-surface/40 hover:border-surface grid size-10 shrink-0 place-items-center rounded-full border transition-colors"
          >
            <svg data-icon="pause" viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <rect x="6" y="5" width="4" height="14" rx="1"></rect>
              <rect x="14" y="5" width="4" height="14" rx="1"></rect>
            </svg>
            <svg
              data-icon="play"
              viewBox="0 0 24 24"
              class="hidden size-4"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path>
            </svg>
          </button>
          <dl class="hidden flex-1 grid-cols-3 gap-8 text-sm md:grid">
            <div>
              <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
                {t('info.addressLabel')}
              </dt>
              <dd class="mt-1">{t('info.address')}</dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
                {t('info.hoursLabel')}
              </dt>
              <dd class="mt-1">
                {t('info.hours')} · <span class="opacity-75">{t('info.hoursNote')}</span>
              </dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold tracking-[0.18em] uppercase opacity-70">
                {t('info.contactLabel')}
              </dt>
              <dd class="mt-1">
                <a href={whatsappUrl} class="underline decoration-1 underline-offset-4 hover:opacity-80">
                  {t('info.contact')}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <script>
      // Header: transparent while the hero is under it, solid afterwards.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      if (header && hero) {
        new IntersectionObserver(([entry]) => header.toggleAttribute('data-solid', !entry.isIntersecting), {
          rootMargin: '-80px 0px 0px 0px',
        }).observe(hero);
      }

      // Video: autoplay only when motion is allowed; otherwise the poster frame stays.
      const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      function render(playing: boolean) {
        if (!toggle) return;
        toggle.setAttribute(
          'aria-label',
          (playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) ?? '',
        );
        toggle.querySelector('[data-icon="pause"]')?.classList.toggle('hidden', !playing);
        toggle.querySelector('[data-icon="play"]')?.classList.toggle('hidden', playing);
      }

      if (video && toggle) {
        video.addEventListener('play', () => render(true));
        video.addEventListener('pause', () => render(false));
        toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
        if (!reduce.matches) {
          video
            .play()
            .then(() => (toggle.hidden = false))
            .catch(() => {
              /* Autoplay blocked or codec unsupported: poster stays, no control needed. */
            });
        } else {
          toggle.hidden = false;
          render(false);
        }
      }
    </script>

    <!-- About -->
    <section class="mx-auto max-w-[1320px] px-6 py-20 lg:px-12 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="aspect-[4/3] overflow-hidden rounded-[28px] lg:col-span-5 lg:aspect-[4/5]">
          <Image
            src={aboutImg}
            alt=""
            widths={[400, 640, 880]}
            sizes="(min-width: 1024px) 520px, 100vw"
            class="c-parallax h-full w-full object-cover"
          />
        </div>
        <div class="c-reveal lg:col-span-6 lg:col-start-7">
          <p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">{t('nav.about')}</p>
          <h2 class="font-display mt-5 text-4xl leading-[1.1] font-[380] italic lg:text-5xl rtl:leading-[1.4]">
            {t('about.title')}
          </h2>
          <p class="text-muted mt-7 text-lg leading-relaxed">{t('about.body')}</p>
          <div class="border-line mt-10 border-t pt-8">
            <p class="text-sm font-semibold">{t('about.credLabel')}</p>
            <ul class="text-muted mt-4 space-y-3">
              <li class="flex gap-3">
                <span class="bg-accent mt-2.5 h-px w-5 shrink-0" aria-hidden="true"></span>
                {t('about.cred1')}
              </li>
              <li class="flex gap-3">
                <span class="bg-accent mt-2.5 h-px w-5 shrink-0" aria-hidden="true"></span>
                {t('about.cred2')}
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Treatments -->
    <section id="tedaviler" class="bg-panel">
      <div class="mx-auto max-w-[1320px] px-6 py-20 lg:px-12 lg:py-28">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <h2 class="font-display text-4xl font-[380] italic lg:text-6xl">{t('nav.treatments')}</h2>
            <p class="text-muted mt-5 max-w-[40ch] leading-relaxed">{t('treatments.intro')}</p>
          </div>
          <a href="#" class="group inline-flex items-center gap-2 text-sm font-semibold">
            {t('treatments.all')}
            <span
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1"
            >
              →
            </span>
          </a>
        </div>
        <ul class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {treatmentKeys.map((key) => (
            <li class="c-reveal">
              <a href="#" class="group block">
                <div class="overflow-hidden rounded-[22px]">
                  <Image
                    src={treatmentImages[key]}
                    alt=""
                    widths={[320, 480, 720]}
                    sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                    class="aspect-[5/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  />
                </div>
                <h3 class="font-display group-hover:text-accent mt-6 text-2xl font-[420] italic transition-colors">
                  {t(`treat.${key}`)}
                </h3>
                <p class="text-muted mt-2">{t(`treat.${key}.desc`)}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Appointment band -->
    <section class="mx-auto max-w-[1320px] px-6 py-20 lg:px-12 lg:py-24">
      <div class="bg-ink text-surface flex flex-col items-start justify-between gap-8 rounded-[32px] px-8 py-12 md:flex-row md:items-center lg:px-16 lg:py-16">
        <div>
          <h2 class="font-display text-3xl leading-tight font-[380] italic lg:text-[2.75rem] rtl:leading-[1.4]">
            {t('band.title')}
          </h2>
          <p class="mt-4 opacity-75">{t('band.body')}</p>
        </div>
        <a
          href={whatsappUrl}
          class="bg-surface text-ink hover:bg-panel shrink-0 rounded-full px-8 py-4 text-sm font-semibold transition-colors"
        >
          {t('cta.appointment')}
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-line border-t">
      <div class="mx-auto grid max-w-[1320px] gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-12">
        <div>
          <p class="font-display text-2xl italic" lang="en" dir="ltr">
            Moonrose
          </p>
          <p class="text-muted mt-4 max-w-[30ch] text-sm leading-relaxed">{t('footer.note')}</p>
        </div>
        <div>
          <p class="text-sm font-semibold">{t('info.addressLabel')}</p>
          <p class="text-muted mt-3 text-sm leading-relaxed">{t('info.address')}</p>
        </div>
        <div>
          <p class="text-sm font-semibold">{t('info.hoursLabel')}</p>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            {t('info.hours')}
            <br />
            {t('info.hoursNote')}
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold">{t('info.phoneLabel')}</p>
          <a href={site.phoneHref} class="text-muted hover:text-accent mt-3 block text-sm" dir="ltr">
            {site.phoneDisplay}
          </a>
        </div>
      </div>
    </footer>

    <!-- Floating WhatsApp with a label bubble on wide screens -->
    <a
      href={whatsappUrl}
      aria-label={t('a11y.whatsapp')}
      class="group fixed end-5 bottom-5 z-50 flex items-center gap-3"
    >
      <span
        class="bg-surface text-ink hidden rounded-full py-2.5 ps-4 pe-4 text-sm font-semibold shadow-[0_10px_30px_-12px_rgb(15_42_74/0.45)] lg:block"
        aria-hidden="true"
      >
        {t('whatsapp.bubble')}
      </span>
      <span class="bg-accent text-surface group-hover:bg-ink grid size-14 place-items-center rounded-full shadow-[0_10px_30px_-10px_rgb(15_42_74/0.5)] transition-colors">
        <svg
          viewBox="0 0 24 24"
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.6z"></path>
          <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8A4 4 0 0 1 10.7 11l.8-1-1-2z"></path>
        </svg>
      </span>
    </a>
  </div>
</BaseLayout>
